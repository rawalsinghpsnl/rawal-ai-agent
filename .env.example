# Docker Compose Environment Configuration
# Copy this file to .env and fill in the required values
# IMPORTANT: Set SECRET_KEY and JWT_SECRET to strong random values for production!

# Generate secure secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=

# Authentication (optional for local development, recommended for production)
AUTH_PASSWORD=
AUTH_USERNAME=rawal

# LLM Provider Configuration
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# Sandbox Configuration
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=rawal-ai-agent-sandbox:latest
